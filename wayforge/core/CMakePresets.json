{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    { "name": "desktop-debug",   "displayName": "Desktop Debug (Ninja)",   "generator": "Ninja", "binaryDir": "${sourceDir}/../build/desktop", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "desktop-release", "displayName": "Desktop Release (Ninja)", "generator": "Ninja", "binaryDir": "${sourceDir}/../build/desktop-release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "vs2022", "displayName": "Visual Studio 2022 x64", "generator": "Visual Studio 18 2026", "architecture": "x64", "binaryDir": "${sourceDir}/../build/vs2022" },
    { "name": "android-arm64", "displayName": "Android arm64-v8a (needs ANDROID_NDK)", "generator": "Ninja", "binaryDir": "${sourceDir}/../build/android-arm64-v8a",
      "cacheVariables": { "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake", "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-26", "ANDROID_STL": "c++_static", "CMAKE_BUILD_TYPE": "Release", "WF_BUILD_VIEWER": "OFF", "WF_BUILD_TESTS": "OFF", "WF_BUILD_CLI": "OFF" } }
  ],
  "buildPresets": [
    { "name": "desktop-debug", "configurePreset": "desktop-debug" },
    { "name": "desktop-release", "configurePreset": "desktop-release" },
    { "name": "android-arm64", "configurePreset": "android-arm64" }
  ],
  "testPresets": [
    { "name": "desktop-debug", "configurePreset": "desktop-debug", "output": { "outputOnFailure": true } }
  ]
}
