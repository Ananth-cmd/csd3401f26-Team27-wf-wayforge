<?xml version="1.0" encoding="utf-8"?>
<UXML xmlns="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="./SpriteFrameModuleSettings.uss" />
    <Toggle name="spriteFrameEditCapabilityOverride" label="Sprite Frame field edit lock override" class="toggle" tooltip="Allow unlocking field editing in Sprite Frame that are locked by the importer."/>
    <HelpBox name="spriteFrameEditCapabilityOverrideWarning" message-type="Info" text="Editing importer locked field deprecated. Unlocking fields for editing is temporarily available for now, but this option may be removed in a future version."/>
</UXML>
