.app { flex-grow: 1; background-color: #f5f8f8; color: #102e2b; font-size: 14px; }
.page { flex-grow: 1; }
.page-scroll { flex-grow: 1; }
.content { padding: 34px 24px 18px 24px; }
Label { white-space: normal; margin: 0; padding: 0; }
Button { border-width: 0; margin: 0; padding: 0; background-color: white; color: #102e2b; -unity-font-style: bold; white-space: normal; }
Button:hover { background-color: #e2f0eb; }
Button:active { background-color: #b9dacf; }
Button:focus { border-color: #46a491; border-width: 2px; }
.hero { font-size: 29px; -unity-font-style: bold; margin-top: 14px; margin-bottom: 6px; }
.title { font-size: 22px; -unity-font-style: bold; flex-shrink: 1; }
.subtitle { color: #617873; font-size: 13px; margin-top: 4px; margin-bottom: 22px; }
.body { color: #617873; font-size: 14px; margin-bottom: 16px; }
.eyebrow { font-size: 11px; -unity-font-style: bold; color: #617873; margin-bottom: 12px; }
.brand { color: #006b5e; font-size: 12px; margin-bottom: 0; }
.section { margin-top: 22px; }
.caption { font-size: 10px; color: #617873; margin-top: 12px; }
.row { flex-direction: row; align-items: center; justify-content: space-between; }
.header { margin-bottom: 20px; justify-content: flex-start; }
.header .title { margin-left: 13px; }
.icon-button { width: 44px; height: 44px; border-radius: 14px; align-items: center; justify-content: center; flex-shrink: 0; }
.search-button { height: 58px; border-radius: 18px; padding-left: 53px; color: #617873; font-size: 15px; margin-bottom: 16px; -unity-font-style: normal; -unity-text-align: middle-left; }
.search-button Image { position: absolute; left: 17px; top: 18px; }
.search-field { height: 58px; margin: 0 0 18px 0; }
.search-field .unity-text-field__input { background-color: white; border-width: 0; border-radius: 16px; padding: 14px 16px; color: #102e2b; font-size: 16px; }
.chip { flex-grow: 1; height: 44px; border-radius: 22px; margin-right: 6px; font-size: 12px; color: #617873; margin-bottom: 14px; }
.selected { background-color: #006b5e; color: white; }
.place-card { min-height: 78px; border-radius: 18px; flex-direction: row; align-items: center; padding: 14px; margin-bottom: 12px; }
.icon-box { width: 44px; height: 44px; border-radius: 13px; background-color: #f4f8f7; align-items: center; justify-content: center; flex-shrink: 0; }
.card-copy { flex-grow: 1; flex-shrink: 1; margin: 0 14px; }
.card-copy Label { -unity-text-align: middle-left; }
.card-title { font-size: 15px; -unity-font-style: bold; margin-bottom: 4px; }
.card-subtitle { font-size: 12px; color: #617873; -unity-font-style: normal; }
.note { border-radius: 20px; background-color: #ddf1e9; padding: 16px; margin-top: 14px; margin-bottom: 18px; }
.note-title { color: #006b5e; font-size: 13px; -unity-font-style: bold; margin-bottom: 5px; }
.note-body { color: #617873; font-size: 12px; }
.primary, .secondary { min-height: 54px; border-radius: 16px; font-size: 15px; margin-top: 10px; padding: 12px 16px; }
.primary { background-color: #006b5e; color: white; }
.primary:hover { background-color: #00584d; }
.primary:disabled { background-color: #d5e2de; color: #617873; }
.primary { margin-bottom: 12px; }
.secondary { background-color: #ddf1e9; color: #006b5e; }
.bottom-nav { background-color: white; border-radius: 24px; height: 69px; margin: 0 12px 12px 12px; padding: 6px 8px; flex-shrink: 0; }
.nav-button { flex-grow: 1; height: 56px; border-radius: 16px; justify-content: center; align-items: center; margin-right: 4px; }
.nav-label { font-size: 11px; margin-top: 4px; color: #617873; }
.active { background-color: #ddf1e9; }
.active .nav-label { color: #006b5e; }
.map-card { border-radius: 24px; overflow: hidden; background-color: #eaf1ef; flex-shrink: 0; margin-bottom: 4px; }
.map-image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-top { position: absolute; top: 12px; left: 12px; right: 12px; }
.map-controls { position: absolute; bottom: 12px; left: 12px; right: 12px; justify-content: flex-end; }
.map-chip { min-width: 52px; height: 44px; padding: 0 14px; border-radius: 16px; font-size: 12px; color: #006b5e; margin-left: 5px; align-items: center; justify-content: center; }
.zoom { min-width: 44px; padding: 0; font-size: 18px; }
.compass { min-width: 44px; }
.set-start { position: absolute; bottom: 15px; left: 12px; right: 12px; height: 54px; border-radius: 15px; padding: 0 14px 0 48px; font-size: 13px; -unity-text-align: middle-left; }
.set-start Image { position: absolute; left: 14px; top: 16px; }
.direction { border-radius: 22px; background-color: #006b5e; padding: 20px; margin-bottom: 16px; }
.direction-title { color: white; font-size: 18px; -unity-font-style: bold; margin-top: 8px; }
.direction-subtitle { color: #cbece0; font-size: 13px; margin-top: 10px; }
.arrival-badge { width: 94px; height: 94px; border-radius: 47px; background-color: #ddf1e9; align-self: center; align-items: center; justify-content: center; margin-top: 36px; margin-bottom: 20px; }
.centered { -unity-text-align: middle-center; }
.actions { flex-shrink: 0; padding: 0 24px 16px 24px; background-color: #f5f8f8; }
.actions .primary { margin-bottom: 0; }
.unity-progress-bar { margin: 8px 0; }
.unity-progress-bar__background { background-color: #ddf1e9; border-width: 0; border-radius: 8px; }
.unity-progress-bar__progress { background-color: #006b5e; border-width: 0; border-radius: 8px; }
.unity-progress-bar__title { font-size: 11px; color: #102e2b; }
