# \file site2-backend.service
# \brief systemd service that keeps the site 2 backend running (starts on boot, restarts on crash)
#
# On the VM this file is /etc/systemd/system/site2-backend.service.
# Logs: journalctl -u site2-backend -f      Restart: sudo systemctl restart site2-backend
#
# \author Joel Chua (c.jialiang@digipen.edu)
# AI declaration: Claude Opus was used as a support tool for debugging, build infrastructure and the header comments.
# \date 2026-10-21
# \copyright 2026 DigiPen Institute of Technology Singapore. All rights reserved.
[Unit]
Description=Site 2 backend (Node, behind nginx on port 5001)
After=network.target

[Service]
User=team27
WorkingDirectory=/home/team27/site2/server
Environment=HOST=127.0.0.1
Environment=PORT=8081
Environment=SITE2_DATA=/home/team27/site2/server/data
ExecStart=/usr/bin/node /home/team27/site2/server/server.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
